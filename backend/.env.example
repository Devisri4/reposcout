# Copy to backend/.env (git-ignored) for local runs. Never commit the real file.
# Free key: https://console.groq.com/keys - replace not-set with it (an empty value stops the app starting).
GROQ_API_KEY=not-set
# Optional: raises GitHub's API limit from 60 to 5000 calls/hour (no scopes needed).
GITHUB_TOKEN=
# Optional: Postgres for saved job matches (Neon free plan). Leave empty to use an in-memory H2 database.
DATABASE_URL=
